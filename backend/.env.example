# Runtime
NODE_ENV=development
PORT=5001
BASE_URL=http://localhost:5001

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/sistema-burger?replicaSet=rs0

# Atención habilitada; SALON se conserva para una futura ampliación.
ORDER_TYPES=DELIVERY,TAKEAWAY

# Circuito comercial heredado; deshabilitado para la hamburguesería.
ENABLE_PREPIZZAS=false

# Authentication
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1d

# Cantidad de saltos confiables, verificada en el despliegue. Acceso directo/local: 0.
# No usar un valor mayor al de la infraestructura real.
TRUST_PROXY=0

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174


